--Select kuvab ainult 2 veergu tabelist
SELECT tootja, telefonMudel AS mudel FROM telefon;
--sorteerimine
--ASC kasvavas järjekorras
SELECT tootja, telefonMudel AS mudel, hind
FROM telefon
ORDER BY hind ASC; -- võib olla ilma ASC

--DESC kahanevas järjekorras
SELECT tootja, telefonMudel AS mudel, hind
FROM telefon
ORDER BY hind DESC;

--võrdlemine >, <, =, <=, >=
SELECT telefonMudel, hind
FROM telefon
WHERE hind >35
ORDER by hind;

--leia mudelid vahemikus 10-15 euro
SELECT telefonMudel, hind
FROM telefon
WHERE hind BETWEEN 10 and 15
ORDER by hind;

--sama päring ilma between
SELECT telefonMudel, hind
FROM telefon
where hind >=10 AND hind <=15
ORDER by hind;

--distinct ?! näitab ainult üks kordus
SELECT DISTINCT OS from telefon;

--võrdlemine tekstiga LIKE
SELECT telefonMudel, tootja FROM telefon
WHERE tootja LIKE 'Samsung'

--IN kuvab vastavus loetelus - соответствие перечислению
SELECT tootja, telefonMudel
from telefon
WHERE tootja in ('Sony', 'Samsung', 'Motorola');

--Ilma IN
SELECT telefonMudel, tootja FROM telefon
WHERE tootja LIKE 'Samsung' OR tootja LIKE 'Motorola' OR tootja LIKE 'Sony';

--leia mudelid mis algavad S tähega
--% tähendab üks kõik sümboolit
SELECT telefonMudel, tootja FROM telefon
WHERE telefonMudel LIKE 'S%'
--sisaldab s täht: '%s%'

--agregaat funktsioonid: AVG, MAX, MIN, SUM, COUNT
--keskmine väljastamise aasta
SELECT AVG(v_aasta) AS keskmineAasta
FROM telefon
--MAX
SELECT MAX(v_aasta) AS keskmineAasta
FROM telefon
--MIN
SELECT MIN(v_aasta) AS keskmineAasta
FROM telefon
--telefonide üldkogus
SELECT Count(*) AS 'üldKogus'
FROM telefon
--Sum
SELECT SUM(hind) AS keskmineHind
FROM telefon

--Keeruline variant funktsiooniga
--Telefonide üldkogus iga tootja kohta
SELECT tootja, Count(*) AS 'üldKogus'
FROM telefon
GROUP BY tootja;

--top 6
SELECT TOP 6 tootja, hind
FROM telefon
ORDER BY hind DESC
